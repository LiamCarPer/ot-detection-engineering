{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LiamCarPer/ot-detection-engineering/main/purple/emulation/plan.schema.json",
  "title": "Adversary emulation plan",
  "type": "object",
  "required": ["name", "version", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "expectations"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "technique": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
          "execute": {
            "type": "object",
            "required": ["command"],
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string", "minLength": 1 }
            }
          },
          "expectations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["signal", "technique", "rule"],
              "additionalProperties": false,
              "properties": {
                "signal": { "type": "string", "minLength": 1 },
                "technique": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
                "rule": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
