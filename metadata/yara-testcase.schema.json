{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yara-testcase.schema.json",
  "title": "YARA rule test cases",
  "description": "Schema for the *.test.yaml sidecar that accompanies each YARA rule. A YARA rule scans a file or payload blob, so the fixture names an artifact on disk rather than an event.",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "expect", "file"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "expect": { "enum": ["match", "no_match"] },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Repository-relative path to the artifact to scan."
          }
        }
      }
    }
  }
}
