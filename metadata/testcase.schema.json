{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LiamCarPer/ot-detection-engineering/main/metadata/testcase.schema.json",
  "title": "Sigma rule test cases",
  "description": "Schema for the *.test.yaml sidecar that accompanies each Sigma rule.",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "expect", "event"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human readable description of the scenario."
          },
          "expect": {
            "enum": ["match", "no_match"],
            "description": "Whether the rule is expected to fire on the event."
          },
          "event": {
            "type": "object",
            "minProperties": 1,
            "description": "Normalized telemetry event evaluated against the rule."
          }
        }
      }
    }
  }
}
