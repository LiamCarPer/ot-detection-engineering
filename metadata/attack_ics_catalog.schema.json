{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LiamCarPer/ot-detection-engineering/main/metadata/attack_ics_catalog.schema.json",
  "title": "MITRE ATT&CK for ICS catalog",
  "description": "Reduced ATT&CK for ICS catalog produced by scripts/build_attack_catalog.py.",
  "type": "object",
  "required": ["catalog_version", "source", "attack_version", "tactics", "techniques"],
  "additionalProperties": true,
  "properties": {
    "catalog_version": { "type": "integer", "const": 1 },
    "source": { "type": "string" },
    "attack_version": { "type": "string" },
    "attack_release_date": { "type": "string" },
    "source_url": { "type": "string" },
    "tactics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "shortname"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^TA[0-9]{4}$" },
          "name": { "type": "string", "minLength": 1 },
          "shortname": { "type": "string", "minLength": 1 }
        }
      }
    },
    "techniques": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "is_subtechnique", "tactics", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
          "name": { "type": "string", "minLength": 1 },
          "is_subtechnique": { "type": "boolean" },
          "tactics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^TA[0-9]{4}$" }
          },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
