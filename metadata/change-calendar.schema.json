{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-calendar.schema.json",
  "title": "Approved engineering-change calendar",
  "description": "The policy the change-window stateful detection joins against. A write is approved only when a window matches source, destination, service and time.",
  "type": "object",
  "required": ["version", "windows"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "starts", "ends", "src_ip", "dst_ip", "service"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "starts": { "type": "string", "minLength": 1 },
          "ends": { "type": "string", "minLength": 1 },
          "src_ip": { "type": "string", "minLength": 1 },
          "dst_ip": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "approved_by": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
