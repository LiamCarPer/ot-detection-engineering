{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conduit-policy.schema.json",
  "title": "OT zone and conduit policy",
  "description": "The intended segmentation, as code: Purdue zones with their address ranges, and the conduits (allowed zone-to-zone paths, with the services each permits) between them. The conduit rules in rules/conduit flag traffic that violates it.",
  "type": "object",
  "required": ["version", "zones", "conduits"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "purdue", "cidr"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purdue": { "type": "string", "minLength": 1 },
          "cidr": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conduits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "ports": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "integer" }
          },
          "protocols": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
