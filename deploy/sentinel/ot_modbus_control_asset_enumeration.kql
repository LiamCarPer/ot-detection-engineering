// source: rules/sigma/ot/ot_modbus_control_asset_enumeration.yml
OTTelemetry
| where direction =~ "request" and (function_code in~ ("3", "4")) and isnotempty(src_ip) and (not(src_ip =~ "172.22.0.10"))
| summarize value_count = dcount(dst_ip) by bin(TimeGenerated, 5m), src_ip
| where value_count >= 3
